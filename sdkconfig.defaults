# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.4.0 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_SPEED_80M=y
# malloc()/new above 1 KB goes to PSRAM first; internal SRAM is kept for the BLE controller, DMA and stacks.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
# EXT_RAM_BSS_ATTR globals (Recorder buffers) and the bt library's .bss in PSRAM.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# mbedTLS (HTTPS update check) allocates its ~40 KB of handshake/record buffers from PSRAM.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# NimBLE host heap (mbufs, GATT state) in PSRAM; the controller stays internal.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=2000000
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_BROOKESIA_ENABLE_AI_FRAMEWORK=n
CONFIG_ESP_BROOKESIA_GUI_ENABLE_ANIM_PLAYER=n
CONFIG_ESP_BROOKESIA_ENABLE_SERVICES=n
CONFIG_ESP_BROOKESIA_SYSTEMS_ENABLE_SPEAKER=n
CONFIG_BOOST_MATH_ENABLED=n
CONFIG_BOOST_SERIALIZATION_ENABLED=n
# LVGL heap in PSRAM (main/lv_mem_core_psram.c); keeps internal SRAM for BLE/Wi-Fi/DMA.
CONFIG_LV_USE_CUSTOM_MALLOC=y
# LVGL fast functions in IRAM cost about 64 KB of internal SRAM (IRAM and DRAM share it on the S3):
# with it on, the BLE controller has no room left at boot.
# CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM is not set
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_FONT_MONTSERRAT_8=y
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_30=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_34=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_38=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_42=y
CONFIG_LV_FONT_MONTSERRAT_44=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_BUILD_EXAMPLES=n
# Core split: radio (BT controller, NimBLE host, Wi-Fi, lwIP) on core 0,
# LVGL + display/touch interrupts on core 1 (see main.cpp run_on_core).
CONFIG_BT_NIMBLE_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
# NimBLE host logs every GATT notify at INFO (two lines per HID report). Warnings and errors only.
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
# Wi-Fi DMA buffers live in internal SRAM (the Wi-Fi MAC cannot DMA from PSRAM). With BLE up, 16 TX + 10 RX + CSI
# did not fit (esp_wifi_init: "Expected to init 10 rx buffer, actual is 5", ESP_ERR_NO_MEM at 61 KB free).
# 8 TX (~13 KB) + 6 RX (~13 KB, >= RX_BA_WIN 6) is plenty for HTTP; CSI is unused (~1 KB per RX buffer).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
# CONFIG_ESP_WIFI_CSI_ENABLED is not set
